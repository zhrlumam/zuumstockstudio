# ==========================================
# ZUUMSTOCK STUDIO
# ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=production
APP_URL=https://YOUR-PROJECT.vercel.app

# GEMINI AI
GEMINI_API_KEY=
GEMINI_MODEL=

# OTHER AI PROVIDERS
OPENROUTER_API_KEY=
HF_API_KEY=
OPENAI_COMPAT_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# DATABASE
DATABASE_URL=

# VERCEL BLOB STORAGE
BLOB_READ_WRITE_TOKEN=

# S3 / CLOUDFLARE R2
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ADMIN AUTHENTICATION
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=admin

# SESSION SECURITY
SESSION_SECRET=
SESSION_TTL_HOURS=24

# DATABASE SECURITY
PG_SSL_REJECT_UNAUTHORIZED=true

# GENERATION SETTINGS
MAX_GENERATION_BATCH=5
GENERATION_TIMEOUT_MS=60000
