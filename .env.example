# =========================================================
# ZuumStock Studio — Environment Configuration Template
# Copy to .env for local development or set in Vercel Dashboard
# =========================================================

# AI Provider API Keys (Server-side only, never exposed to client)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENROUTER_API_KEY=""
HF_API_KEY=""
OPENAI_COMPAT_API_KEY=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_BASE_URL=""
OLLAMA_BASE_URL="http://localhost:11434"

# PostgreSQL Production Database (Required on Vercel / Production)
# Example: postgres://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""
POSTGRES_URL=""
PG_SSL_REJECT_UNAUTHORIZED="true"

# Cloud Object Storage (Vercel Blob OR S3 / Cloudflare R2)
BLOB_READ_WRITE_TOKEN=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Authentication & Session Security (Required in Production)
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=""
SESSION_TTL_HOURS="24"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
ADMIN_PASSWORD_HASH=""

# Application Host URL
APP_URL="http://localhost:3000"
